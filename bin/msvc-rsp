#!/usr/bin/env python3
"""Run an msvc-wine tool, translating Unix paths inside @response files first.

    msvc-rsp <tool> [args...]

msvc-wine's wine-msvc.sh rewrites absolute Unix paths in the *arguments* to
Wine's z: drive, and that is enough as long as everything is on the command
line. It is not enough once a response file is involved: link.exe and lib.exe
read those themselves, well past any shell that could have rewritten them, and
an absolute Unix path inside one is not merely unreadable -- a leading "/" is
an option prefix on Windows, so the linker silently treats the library as an
unrecognised switch and the build fails with unresolved symbols that point
nowhere near the cause.

Response files are unavoidable here. Windows caps a command line at 32767
characters and cross builds blow through that (see the toolchain files), so the
choice is between a hang and this.

The rewrite is conservative in the same way bin/wine-exec is: a token is only
touched when it looks like an absolute path *and* its parent directory exists,
so "/nologo", "/machine:x64" and friends are left alone. "/DEF:/path/to.def"
and similar option-with-path forms are handled by rewriting only the part after
the colon.
"""

import os
import subprocess
import sys

def _is_hostpath(text):
    """True when text looks like an absolute host path that really exists.

    The two-component requirement is what keeps "/nologo" and "/machine:x64"
    out: their parent would be "/", which is a directory, so existence alone
    would happily accept them.
    """
    if not text.startswith('/') or '/' not in text[1:]:
        return False
    parent = os.path.dirname(text)
    return bool(parent) and os.path.isdir(parent)


def _token_spans(text):
    """Yield (start, end) of each whitespace-separated token, honouring quotes."""
    spans, start, quoted = [], None, False
    for i, ch in enumerate(text):
        if ch == '"':
            quoted = not quoted
            if start is None:
                start = i
        elif ch.isspace() and not quoted:
            if start is not None:
                spans.append((start, i))
                start = None
        elif start is None:
            start = i
    if start is not None:
        spans.append((start, len(text)))
    return spans


def _insert_at(raw):
    """Offset within raw where "z:" belongs, or None to leave it alone.

    MSVC attaches paths to options with no separator at all -- /FI<path>,
    /Yc<path>, /Fo<path>, /I<path>, /external:I<path> -- and that is what breaks:
    cl reads "/FI/home/..." as "/FI" followed by a *new* option, because a
    leading "/" starts one, and reports "D8004: '/FI' requires an argument"
    about a command line that looks perfectly well-formed. So the path is found
    by scanning rather than by matching a list of option spellings.
    """
    # A define is text, not a path; -DFOO=/bar must survive untouched.
    if raw.lstrip('"')[:2] in ('-D', '/D'):
        return None

    for i, ch in enumerate(raw):
        if ch != '/':
            continue
        # The path must begin right after an option prefix, so nothing before it
        # may look like a path itself. Without this the scan matches inside a
        # *relative* path: /lib is a real directory on Linux, so
        # CMakeFiles/x.dir/external/libiconv-1.14/lib/iconv.c.obj came out as
        # ...libiconv-1.14z:/lib/iconv.c.obj and the linker reported a missing
        # input file that had never been missing.
        if '/' in raw[:i].replace('"', '')[1:]:
            return None
        if _is_hostpath(raw[i:].replace('"', '')):
            return i
    return None


def main(argv):
    if len(argv) < 2:
        sys.stderr.write('usage: msvc-rsp <tool> [args...]\n')
        return 2

    tool, args = argv[1], []
    for arg in argv[2:]:
        if not arg.startswith('@') or not os.path.isfile(arg[1:]):
            args.append(arg)
            continue

        original = arg[1:]
        text = open(original, 'r', errors='surrogateescape').read()

        # Splice "z:" in at the offsets that need it and copy every other byte
        # through untouched. Re-serialising from parsed tokens instead would
        # mean re-quoting them, and that loses escaped quotes inside a define:
        # -DVER="\"6.10.8\"" came back as -DVER=\6.10.8\ and the compiler
        # then tried to open a source file named after the fragment.
        edits = [(start + off, ) for start, stop in _token_spans(text)
                 for off in (_insert_at(text[start:stop]),) if off is not None]
        out, prev = [], 0
        for (at, ) in edits:
            out.append(text[prev:at])
            out.append('z:')
            prev = at
        out.append(text[prev:])

        copy = original + '.wine'
        with open(copy, 'w', errors='surrogateescape') as handle:
            handle.write(''.join(out))
        args.append('@' + copy)

    return subprocess.call([tool] + args)


if __name__ == '__main__':
    sys.exit(main(sys.argv))
