#!/usr/bin/env python3
"""Run a command with a pty attached, so Wine gives its children a console.

    wine-pty <command> [args...]

Use it for the whole build:

    wine-pty cmake --build --preset <preset>

Qt's command line tools decide between printing a message and showing a dialog
with QCommandLineParser's displayMessageBox(), which comes down to

    if (GetConsoleWindow()) return false;

Wine only reports a console window when the process actually has a console, and
it has none when its standard handles are a plain pipe or file -- which is what
a build system hands it. So a Qt tool that wants to print anything, usage text
included, opens a MessageBox instead.

That has two failure modes and both were hit here. With a display, a dialog
appears on the desktop and blocks its process until somebody dismisses it, which
during a parallel build means a queue of them. With no display, there is nothing
to show the dialog on and the process simply never returns: CMake's generate
step ran `rcc.exe -h` to probe for --list support and hung there indefinitely,
having produced no output and consumed no CPU, which reads like a deadlock in
CMake rather than a message nobody can see.

A pty is a console as far as Wine is concerned, so GetConsoleWindow() answers
and the tool writes to stdout like it meant to. Attaching one at the top of the
build is enough; every child inherits it.

Terminal escapes from Wine's console are stripped on the way out, so logs stay
readable and greppable.
"""

import os
import pty
import re
import select
import sys

# CSI / OSC sequences that Wine's console emits for cursor control.
_ESCAPES = re.compile(rb'\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]')


def main(argv):
    if len(argv) < 2:
        sys.stderr.write('usage: wine-pty <command> [args...]\n')
        return 2

    # An explicit fork rather than pty.spawn: that helper also pumps this
    # process's stdin into the child, and a build driver has no stdin to give,
    # so the first EOF there would tear the pty down mid-command.
    pid, master = pty.fork()
    if pid == 0:
        try:
            os.execvp(argv[1], argv[1:])
        except OSError as exc:
            sys.stderr.write('wine-pty: %s: %s\n' % (argv[1], exc.strerror))
        os._exit(127)

    out = sys.stdout.buffer
    while True:
        try:
            ready, _, _ = select.select([master], [], [], 1.0)
        except InterruptedError:
            continue
        if ready:
            try:
                data = os.read(master, 65536)
            except OSError:
                break
            if not data:
                break
            out.write(_ESCAPES.sub(b'', data).replace(b'\r\n', b'\n'))
            out.flush()
        elif os.waitpid(pid, os.WNOHANG)[0] == pid:
            break

    os.close(master)
    _, status = os.waitpid(pid, 0)
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return os.WEXITSTATUS(status)


if __name__ == '__main__':
    sys.exit(main(sys.argv))
